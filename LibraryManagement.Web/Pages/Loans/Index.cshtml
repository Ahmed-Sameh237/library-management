@page
@model LibraryManagement.Web.Pages.Loans.IndexModel
@{
    ViewData["Title"] = "Loans";
}

<h1>Loans</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<p><a asp-page="Borrow" class="btn btn-primary">Borrow a book</a></p>

<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.Filter == "active" ? "active" : "")" asp-page="Index" asp-route-filter="active">Active</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Filter == "overdue" ? "active" : "")" asp-page="Index" asp-route-filter="overdue">Overdue</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Filter == "all" ? "active" : "")" asp-page="Index" asp-route-filter="all">All</a>
    </li>
</ul>

@if (Model.Loans.Any())
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Book</th>
                <th>Member</th>
                <th>Borrowed</th>
                <th>Due</th>
                <th>Returned</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loan in Model.Loans)
            {
                <tr>
                    <td>@loan.Book?.Title</td>
                    <td>@loan.Member?.FullName</td>
                    <td>@loan.BorrowedOn.ToString("yyyy-MM-dd")</td>
                    <td>@loan.DueDate.ToString("yyyy-MM-dd")</td>
                    <td>@(loan.ReturnedOn?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <td>
                        @if (!loan.IsActive)
                        {
                            <span class="badge bg-success">Returned</span>
                        }
                        else if (loan.IsOverdue)
                        {
                            <span class="badge bg-danger">Overdue</span>
                        }
                        else
                        {
                            <span class="badge bg-primary">Borrowed</span>
                        }
                    </td>
                    <td>
                        @if (loan.IsActive)
                        {
                            <form method="post" asp-page-handler="Return"
                                  asp-route-id="@loan.Id" asp-route-filter="@Model.Filter" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">Return</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No loans to show.</p>
}