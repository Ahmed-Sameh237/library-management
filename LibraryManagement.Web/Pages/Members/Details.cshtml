@page "{id:int}"
@model LibraryManagement.Web.Pages.Members.DetailsModel
@{
    ViewData["Title"] = Model.Member.FullName;
}

<h1>@Model.Member.FullName</h1>

<dl class="row">
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Member.Email</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@(Model.Member.Phone ?? "-")</dd>

    <dt class="col-sm-3">Joined</dt>
    <dd class="col-sm-9">@Model.Member.JoinedOn.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Active loans</dt>
    <dd class="col-sm-9">@Model.Member.ActiveLoanCount</dd>
</dl>

<h4>Loan history</h4>
@if (Model.Member.Loans.Any())
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Book</th>
                <th>Borrowed</th>
                <th>Due</th>
                <th>Returned</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loan in Model.Member.Loans.OrderByDescending(l => l.BorrowedOn))
            {
                <tr>
                    <td>@loan.Book?.Title</td>
                    <td>@loan.BorrowedOn.ToString("yyyy-MM-dd")</td>
                    <td>@loan.DueDate.ToString("yyyy-MM-dd")</td>
                    <td>@(loan.ReturnedOn?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <td>
                        @if (!loan.IsActive)
                        {
                            <span class="badge bg-success">Returned</span>
                        }
                        else if (loan.IsOverdue)
                        {
                            <span class="badge bg-danger">Overdue</span>
                        }
                        else
                        {
                            <span class="badge bg-primary">Borrowed</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No loans yet.</p>
}

<a asp-page="Edit" asp-route-id="@Model.Member.Id">Edit</a> |
<a asp-page="Index">Back to list</a>