@{
    // Highlights the current section in the navbar
    var page = (ViewContext.RouteData.Values["page"] as string ?? "").ToLowerInvariant();
    string Active(params string[] prefixes) =>
        prefixes.Any(p => page.StartsWith(p)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LibraryHub</title>

    @* Set the theme before the page paints, so there's no light/dark flash *@
    <script>
        (function () {
            var root = document.documentElement;
            root.classList.add('js');
            try {
                var saved = localStorage.getItem('theme');
                var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                root.setAttribute('data-bs-theme', saved || (dark ? 'dark' : 'light'));
            } catch (e) { }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg sticky-top lib-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-page="/Index">
                    <span class="brand-mark"><i class="bi bi-book-half"></i></span>
                    <span>Library<span class="text-gradient">Hub</span></span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2"></i>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-lg-auto gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link @(page == "/index" ? "active" : "")" asp-page="/Index">
                                <i class="bi bi-house-door me-1"></i>Home
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @Active("/books", "/authors")" href="#"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-collection me-1"></i>Catalog
                            </a>
                            <ul class="dropdown-menu shadow-lg border-0 p-2">
                                <li>
                                    <a class="dropdown-item d-flex gap-3 align-items-center rounded-3 py-2" asp-page="/Books/Index">
                                        <span class="dd-icon"><i class="bi bi-book"></i></span>
                                        <span><strong class="d-block">Books</strong><small class="text-body-secondary">Search and browse the catalog</small></span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex gap-3 align-items-center rounded-3 py-2" asp-page="/Authors/Index">
                                        <span class="dd-icon"><i class="bi bi-person-lines-fill"></i></span>
                                        <span><strong class="d-block">Authors</strong><small class="text-body-secondary">Who wrote what</small></span>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item rounded-3" asp-page="/Books/Create">
                                        <i class="bi bi-plus-circle me-2"></i>Add a new book
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @Active("/members")" asp-page="/Members/Index">
                                <i class="bi bi-people me-1"></i>Members
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Active("/loans")" asp-page="/Loans/Index">
                                <i class="bi bi-arrow-left-right me-1"></i>Loans
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Active("/reports")" asp-page="/Reports/Index">
                                <i class="bi bi-bar-chart-line me-1"></i>Reports
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        <button id="themeToggle" class="btn btn-icon" type="button" aria-label="Toggle dark mode">
                            <i class="bi bi-moon-stars-fill icon-moon"></i>
                            <i class="bi bi-sun-fill icon-sun"></i>
                        </button>
                        <a class="btn btn-primary btn-glow rounded-pill px-4" asp-page="/Loans/Borrow">
                            <i class="bi bi-plus-lg me-1"></i>Borrow a book
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @* The home page sets FullWidth so its sections can span the screen *@
        @if (ViewData["FullWidth"] is true)
        {
            @RenderBody()
        }
        else
        {
            <div class="container py-4 page-enter">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="lib-footer">
        <div class="container py-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="brand-mark brand-mark-sm"><i class="bi bi-book-half"></i></span>
                <span class="text-body-secondary">&copy; @DateTime.Now.Year LibraryHub</span>
            </div>
            <div class="d-flex gap-3 small">
                <a asp-page="/Books/Index">Books</a>
                <a asp-page="/Loans/Index">Loans</a>
                <a asp-page="/Reports/Index">Reports</a>
            </div>
            <a class="small" href="https://github.com/Ahmed-Sameh237/library-management-razor"
               target="_blank" rel="noopener"><i class="bi bi-github me-1"></i>Source on GitHub</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>