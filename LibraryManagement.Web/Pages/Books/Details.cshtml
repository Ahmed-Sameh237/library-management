@page "{id:int}"
@model LibraryManagement.Web.Pages.Books.DetailsModel
@{
    ViewData["Title"] = Model.Book.Title;
}

<h1>@Model.Book.Title</h1>

<dl class="row">
    <dt class="col-sm-3">Author</dt>
    <dd class="col-sm-9">
        <a asp-page="/Authors/Details" asp-route-id="@Model.Book.AuthorId">@Model.Book.Author?.Name</a>
    </dd>

    <dt class="col-sm-3">ISBN</dt>
    <dd class="col-sm-9">@Model.Book.Isbn</dd>

    <dt class="col-sm-3">Published</dt>
    <dd class="col-sm-9">@Model.Book.PublishedYear</dd>

    <dt class="col-sm-3">Copies</dt>
    <dd class="col-sm-9">@Model.Book.AvailableCopies available of @Model.Book.TotalCopies</dd>

    <dt class="col-sm-3">Categories</dt>
    <dd class="col-sm-9">
        @foreach (var category in Model.Book.Categories)
        {
            <span class="badge bg-secondary">@category.Name</span>
        }
    </dd>
</dl>

<a asp-page="Edit" asp-route-id="@Model.Book.Id">Edit</a> |
<a asp-page="Index">Back to list</a>